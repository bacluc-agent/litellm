{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  "minimumReleaseAge": "14 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/./"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s*[A-Za-z_]+[=:]\\s*\"?(?<currentValue>v?[0-9][\\w.-]*)(@(?<currentDigest>[a-z0-9:]*))\"?"
      ],
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": "patch",
      "labels": [
        "renovate",
        "dependency",
        "bump:patch",
      ],
    },
    {
      "matchUpdateTypes": "minor",
      "labels": [
        "renovate",
        "dependency",
        "bump:minor",
      ],
    },
    {
      "matchUpdateTypes": "major",
      "labels": [
        "renovate",
        "dependency",
        "bump:major",
      ],
    },
    {
      "matchFileNames": [
        "/\\.github/.*/",
        "/scripts/.*/",
      ],
      "labels": [
        "renovate",
        "dependency",
      ],
    },
    {
      "matchDepNames": [
        "ghcr.io/berriai/litellm",
        "litellm-helm",
      ],
      "groupName": "litellm",
      // One branch per litellm version (renovate/litellm-X.Y.Z) so each PR can
      // sit out the full minimumReleaseAge and be merged independently,
      // instead of one shared branch being rewritten on every release.
      // The docker tag is v-prefixed but the chart version is not, so the
      // branch topic must not use {{{newValue}}}; newMajor/newMinor/newPatch
      // are tag-format independent.
      "group": {
        "branchTopic": "litellm-{{{newMajor}}}.{{{newMinor}}}.{{{newPatch}}}",
      },
      // A human-closed per-version PR must never be resurrected (group PRs are
      // recreated by default, i.e. "immortal").
      "recreateWhen": "never",
      "internalChecksFilter": "flexible",
    }
  ],
}
